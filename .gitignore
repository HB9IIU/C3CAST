sdkconfig.seeed_xiao_esp32c3

# Large sample video from the upstream project (CC-BY, not needed)
media/

# Editor files: keep only the task that starts the web app
.vscode/

# Personal notes and the duplicate board photo in the root (docs/board-pic.png is used)
projecBrief.txt
/board-pic.png

