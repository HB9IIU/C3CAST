# Python / build outputs
.venv-host/
__pycache__/
*.pyc
.pio/

# Your own settings and runtime files (callsign, board serial number, rendered caches)
webapp/config.json
webapp/cache/
webapp/overlays/
captures/

# ffmpeg with FDK AAC: non-free, must not be redistributed
tools/ffmpeg/

# Generated by PlatformIO / ESP-IDF
sdkconfig.seeed_xiao_esp32c3

# Large sample video from the upstream project (CC-BY, not needed)
media/

# Editor files: keep only the task that starts the web app
.vscode/*
!.vscode/tasks.json

# Personal notes and the duplicate board photo in the root (docs/board-pic.png is used)
projecBrief.txt
/board-pic.png

# Portable build outputs
build/
dist/
