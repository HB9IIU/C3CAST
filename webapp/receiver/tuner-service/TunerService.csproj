<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tuner service: MiniTiouner / PicoTuner receiver for the web page, without any window or video.
    Built from the QOCAST Player's receiver code, which comes from Open Tuner (GPL v3, see LICENSE-GPL-3.0.txt
    and src\OpenTuner\README.txt). Everything it needs is in this folder (src\ and lib\).
    Build: Build-TunerService.cmd (.NET SDK). The result in bin\ runs on Windows 10/11 without any SDK.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>tuner-service</AssemblyName>
    <RootNamespace>QocastPlayer</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <!-- MiniTiouner USB (FTDI D2XX driver wrapper) -->
    <Reference Include="FTD2XX_NET">
      <HintPath>lib\FTD2XX_NET.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Serilog" Version="3.1.2-dev-02097" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <!-- PicoTuner USB -->
    <PackageReference Include="LibUsbDotNet" Version="2.2.29" />
  </ItemGroup>

  <ItemGroup>
    <!-- native libusb 1.0 (x64), needed by LibUsbDotNet for the PicoTuner -->
    <None Include="lib\libusb-1.0.dll" Link="libusb-1.0.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
