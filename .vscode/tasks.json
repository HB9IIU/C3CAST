{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "DATV: Start web app",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv-host\\Scripts\\python.exe",
      "args": ["${workspaceFolder}\\webapp\\app.py"],
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^$",
          "endsPattern": "Running on http://127\\.0\\.0\\.1:5000"
        }
      }
    }
  ]
}
